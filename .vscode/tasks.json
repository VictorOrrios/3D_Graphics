{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "detail": "Compila las cuatro practicas con el preset linux",
      "type": "shell",
      "command": "cmake --build --preset linux",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    }
  ]
}
